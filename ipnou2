#!/bin/bash

verifica_ip() {
   local_ip=$1
   if [[$ip =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]:
   then 
	 IFS='.' read -r i1 i2 i3 i4 <<<"$ip"
    if  ["$i1" -le 255] && ["$i2" -le 255] && ["i3" -le 255 ] && ["$i4" -le 255];
	then return 0
	fi
    fi
	return 1
}

echo "Verificare"
 while read -r ip host rest; do
if verifica_ip "$ip"; then echo "Valid"
else
echo "invalid"
fi
done

